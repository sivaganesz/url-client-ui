# Copy to .env and fill in. .env is gitignored — never commit the real key.
# Issued in Perfox -> Developer -> API keys.
PERFOX_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which workspace. The sidebar takes its name from this URL, so pointing it
# somewhere else relabels the console along with the data.
# No trailing slash: it produces //agents, which answers 401 and looks exactly
# like a bad key. Both proxies trim it, but don't rely on that.
PERFOX_API_BASE=https://siva-workspace-api.perfox.ai/api/v1
PERFOX_MCP_URL=https://siva-workspace-api.perfox.ai/mcp
PROXY_PORT=8787

# ── deployment only ───────────────────────────────────────────────
# Requires a code on every request. Strongly recommended on anything public.
ACCESS_CODE=

# Set to "true" — together with an ACCESS_CODE above — to permit POST /outbound.
# Outbound fails closed: without both, the deployed proxy does not route it and
# the Call button returns 403. This places real calls and sends real messages.
ALLOW_OUTBOUND=

# ── operator calling (a human on the line, in the browser) ────────
# A DIFFERENT credential from PERFOX_API_KEY above: a workspace key does not
# authorise the operator surface, and this secret does not authorise the REST
# API. Both can be set and they are unrelated.
OPERATOR_API_HOST=https://siva-workspace-api.perfox.ai
OPERATOR_SITE_ID=sa_site_live_7WAE96SPSWB6N6Z10314ETKHHWPGBM53
OPERATOR_WORKFLOW_ID=01a0c809-70dc-76b5-9a34-dbd798a3db44

# SERVER-ONLY — signs the operator identity. Anyone holding it can sign in as
# any operator, so it must never appear in a client bundle, a VITE_ variable,
# or a committed file. From Studio -> Sites, on the operator-enabled site.
OPERATOR_SITE_SECRET=

# This console has no login, so it signs ONE fixed identity: every browser that
# opens it is the same operator, and two tabs will contend. Fine for a single
# seat; derive it from a session if this ever gets real users.
OPERATOR_EXTERNAL_ID=op_console
OPERATOR_NAME=Console Operator
