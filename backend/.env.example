# Copy to .env — gitignored. Nothing here belongs in the frontend bundle.

PORT=4300
NODE_ENV=development

# The local docker-compose database. 5433 on the host, so it cannot collide
# with a Postgres someone already runs on 5432.
DATABASE_URL=postgres://urlfactory:urlfactory@localhost:5433/urlfactory

# TLS to that database: auto, require or off. Leave it on auto — it only
# exists so a host whose address looks private when it is not (or the other
# way round) is a setting rather than a code change. See backend/src/db/index.ts.
# DATABASE_SSL=auto

# Encrypts each workspace's Perfox key and operator secret at rest. Generate
# one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing it means every workspace has to be reconfigured. Leaking it next to a
# database dump means every workspace's key is readable. Use a secret manager
# in production, not a file.
ENCRYPTION_KEY=

# How long a session survives without being used.
SESSION_TTL_DAYS=7

# Serve the built frontend from this process, which is what makes the app and
# the API one origin — the session cookie stays SameSite=Lax and the browser
# blocks CSRF without us writing anything. Leave blank in development, where
# Vite serves the app and proxies /api here.
CLIENT_DIST=

# Open registration. Off unless this is "true": the console reaches real
# customer conversations, so accounts are created by us (npm run seed:admin)
# until the invite flow exists.
ALLOW_REGISTRATION=false

# Numbers an agent is allowed to ring, while this is set. Comma-separated;
# spaces, dashes and brackets are ignored on both sides of the comparison.
#
# Empty in production, deliberately: a console whose whole purpose is phoning
# customers cannot carry a list of permitted customers. It is for the other
# situation — a workspace wired to a real carrier with somebody testing
# against it, where a mistyped digit should reach nobody.
# OUTBOUND_ALLOWLIST=+910000000000

# The first administrator, for a boot with nobody watching.
#
# Nothing can be created until an admin exists, and one cannot be made through
# the app. `npm run seed:admin` normally prompts, so the password stays out of
# the shell history — set these three and it runs unattended instead, which is
# what a container entrypoint or a host without a terminal needs.
#
# All three or none: supplying the email and password is what turns the
# prompting off, so a missing name has nobody left to ask. Running it again
# once the admin exists logs that and exits 0, so it is safe on every boot —
# but changing ADMIN_PASSWORD afterwards does nothing, because the existing
# row is never updated. The change-password form is what does that.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
