{
  "name": "url-factory-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Auth, workspace credentials, and the Perfox proxy for the client console.",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "discover": "node discover.js",
    "seed:dev": "node --experimental-strip-types src/db/seed-dev.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "seed:admin": "node --experimental-strip-types src/db/seed-admin.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
